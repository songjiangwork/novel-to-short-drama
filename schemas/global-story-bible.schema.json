{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel-to-short-drama.local/schemas/global-story-bible.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "premise_zh",
    "synopsis_zh",
    "genre",
    "tone",
    "setting",
    "themes",
    "main_character_refs",
    "major_arc_refs",
    "major_turning_point_refs",
    "major_reveal_refs",
    "unresolved_summary",
    "source_conflict_summary",
    "coverage_metadata"
