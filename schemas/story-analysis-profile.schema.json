{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel-to-short-drama.local/schemas/story-analysis-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "working_language",
    "character_analysis_policy_id",
    "plot_window_policy_id",
    "global_skeleton_policy_id",
    "story_bible_policy_id",
    "max_generation_rounds",
    "planning_policy",
    "character_analysis",
    "plot_window_analysis",
    "global_skeleton",
    "story_bible"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "working_language": {
      "type": "string"
    },
    "character_analysis_policy_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "plot_window_policy_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "global_skeleton_policy_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "story_bible_policy_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "max_generation_rounds": {
      "type": "integer",
      "minimum": 1
    },
    "planning_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "character_packet_max_estimated_tokens",
        "plot_window_packet_max_estimated_tokens",
        "plot_window_owned_event_target",
        "plot_window_context_event_count",
        "global_skeleton_packet_max_estimated_tokens",
        "story_bible_packet_max_estimated_tokens"
      ],
      "properties": {
        "character_packet_max_estimated_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "plot_window_packet_max_estimated_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "plot_window_owned_event_target": {
          "type": "integer",
          "minimum": 1
        },
        "plot_window_context_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "global_skeleton_packet_max_estimated_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "story_bible_packet_max_estimated_tokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "character_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_profile_id",
        "prompt_id",
        "prompt_version",
        "output_schema_id",
        "output_schema_version"
      ],
      "properties": {
        "semantic_profile_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "prompt_id": {
          "type": "string"
        },
        "prompt_version": {
          "type": "integer",
          "minimum": 1
        },
        "output_schema_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "output_schema_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "plot_window_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_profile_id",
        "prompt_id",
        "prompt_version",
        "output_schema_id",
        "output_schema_version"
      ],
      "properties": {
        "semantic_profile_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "prompt_id": {
          "type": "string"
        },
        "prompt_version": {
          "type": "integer",
          "minimum": 1
        },
        "output_schema_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "output_schema_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "global_skeleton": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_profile_id",
        "prompt_id",
        "prompt_version",
        "output_schema_id",
        "output_schema_version"
      ],
      "properties": {
        "semantic_profile_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "prompt_id": {
          "type": "string"
        },
        "prompt_version": {
          "type": "integer",
          "minimum": 1
        },
        "output_schema_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "output_schema_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "story_bible": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_profile_id",
        "prompt_id",
        "prompt_version",
        "output_schema_id",
        "output_schema_version"
      ],
      "properties": {
        "semantic_profile_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "prompt_id": {
          "type": "string"
        },
        "prompt_version": {
          "type": "integer",
          "minimum": 1
        },
        "output_schema_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "output_schema_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
