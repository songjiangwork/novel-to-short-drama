{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v1.2 A-I3 Semantic LLM Profile",
  "description": "Result-affecting LLM generation semantics. Deliberately carries no endpoint, timeout, credential, or hostname, and no backend runtime identity (provider_family / model). The backend model is a transport detail carried by the runtime config (request_model / provider_family), so switching backends does not change this semantic identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "temperature",
    "max_output_tokens",
    "structured_output_mode",
    "reasoning"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
    "max_output_tokens": { "type": "integer", "minimum": 1 },
    "structured_output_mode": { "enum": ["none", "json_object", "json_schema"] },
    "reasoning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "effort"],
      "properties": {
        "enabled": { "type": "boolean" },
        "effort": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": false } },
            "required": ["enabled"]
          },
          "then": {
            "properties": { "effort": { "const": null } }
          }
        },
        {
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": {
            "properties": { "effort": { "enum": ["low", "medium", "high"] } }
          }
        }
      ]
    }
  }
}
