{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Character Registry Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "character_id",
    "display_name",
    "looks",
    "voices"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "character_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "persistent_attributes": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "looks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assets"
        ],
        "properties": {
          "assets": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "face_front",
              "face_three_quarter"
            ],
            "properties": {
              "face_front": {
                "type": "string"
              },
              "face_three_quarter": {
                "type": "string"
              },
              "full_body": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "voices": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset"
        ],
        "properties": {
          "asset": {
            "type": "string"
          }
        }
      }
    }
  }
}
