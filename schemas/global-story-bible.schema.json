  "properties": {
    "schema_version": {
      "const": 1
    },
    "premise_zh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text_zh",
        "evidence_mode",
        "supporting_fact_refs",
        "supporting_event_refs",
        "supporting_relationship_refs",
        "supporting_conflict_refs"
      ],
      "properties": {
        "text_zh": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?=.*\\S)[^\\u0000]+$"
        },
        "evidence_mode": {
          "enum": [
            "explicit",
            "inferred"
          ]
        },
        "supporting_fact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^fact_[0-9]{6,}$"
          },
          "uniqueItems": true
        },
        "supporting_event_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^evt_[0-9]{6,}$"
          },
          "uniqueItems": true
        },
        "supporting_relationship_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^rel_[0-9]{6,}$"
          },
