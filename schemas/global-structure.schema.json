{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel-to-short-drama.local/schemas/global-structure.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "main_conflict",
    "secondary_conflicts",
    "main_plot",
    "subplots",
    "ending_state",
    "global_sections",
    "main_character_refs",
    "major_arc_refs",
    "major_turning_point_refs",
    "major_reveal_refs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "main_conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text_zh",
        "evidence_mode",
        "supporting_fact_refs",
        "supporting_event_refs",
        "supporting_relationship_refs",
        "supporting_conflict_refs"
      ],
      "properties": {
        "text_zh": {
          "type": "string"
        },
        "evidence_mode": {
          "enum": [
            "explicit",
            "inferred"
          ]
        },
        "supporting_fact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^fact_[0-9]{6,}$"
          }
        },
        "supporting_event_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^evt_[0-9]{6,}$"
          }
        },
        "supporting_relationship_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^rel_[0-9]{6,}$"
          }
        },
        "supporting_conflict_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^conf_[0-9]{6,}$"
          }
        }
      }
    },
    "secondary_conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text_zh",
          "evidence_mode",
          "supporting_fact_refs",
          "supporting_event_refs",
          "supporting_relationship_refs",
          "supporting_conflict_refs"
        ],
        "properties": {
          "text_zh": {
            "type": "string"
          },
          "evidence_mode": {
            "enum": [
              "explicit",
              "inferred"
            ]
          },
          "supporting_fact_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^fact_[0-9]{6,}$"
            }
          },
          "supporting_event_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^evt_[0-9]{6,}$"
            }
          },
          "supporting_relationship_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^rel_[0-9]{6,}$"
            }
          },
          "supporting_conflict_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^conf_[0-9]{6,}$"
            }
          }
        }
      }
    },
    "main_plot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text_zh",
        "evidence_mode",
        "supporting_fact_refs",
        "supporting_event_refs",
        "supporting_relationship_refs",
        "supporting_conflict_refs"
      ],
      "properties": {
        "text_zh": {
          "type": "string"
        },
        "evidence_mode": {
          "enum": [
            "explicit",
            "inferred"
          ]
        },
        "supporting_fact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^fact_[0-9]{6,}$"
          }
        },
        "supporting_event_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^evt_[0-9]{6,}$"
          }
        },
        "supporting_relationship_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^rel_[0-9]{6,}$"
          }
        },
        "supporting_conflict_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^conf_[0-9]{6,}$"
          }
        }
      }
    },
    "subplots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text_zh",
          "evidence_mode",
          "supporting_fact_refs",
          "supporting_event_refs",
          "supporting_relationship_refs",
          "supporting_conflict_refs"
        ],
        "properties": {
          "text_zh": {
            "type": "string"
          },
          "evidence_mode": {
            "enum": [
              "explicit",
              "inferred"
            ]
          },
          "supporting_fact_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^fact_[0-9]{6,}$"
            }
          },
          "supporting_event_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^evt_[0-9]{6,}$"
            }
          },
          "supporting_relationship_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^rel_[0-9]{6,}$"
            }
          },
          "supporting_conflict_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^conf_[0-9]{6,}$"
            }
          }
        }
      }
    },
    "ending_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text_zh",
        "evidence_mode",
        "supporting_fact_refs",
        "supporting_event_refs",
        "supporting_relationship_refs",
        "supporting_conflict_refs"
      ],
      "properties": {
        "text_zh": {
          "type": "string"
        },
        "evidence_mode": {
          "enum": [
            "explicit",
            "inferred"
          ]
        },
        "supporting_fact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^fact_[0-9]{6,}$"
          }
        },
        "supporting_event_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^evt_[0-9]{6,}$"
          }
        },
        "supporting_relationship_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^rel_[0-9]{6,}$"
          }
        },
        "supporting_conflict_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^conf_[0-9]{6,}$"
          }
        }
      }
    },
    "global_sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section_ordinal",
          "label_zh",
          "event_refs",
          "interpretation"
        ],
        "properties": {
          "section_ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "label_zh": {
            "type": "string"
          },
          "event_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^evt_[0-9]{6,}$"
            }
          },
          "interpretation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text_zh",
              "evidence_mode",
              "supporting_fact_refs",
              "supporting_event_refs",
              "supporting_relationship_refs",
              "supporting_conflict_refs"
            ],
            "properties": {
              "text_zh": {
                "type": "string"
              },
              "evidence_mode": {
                "enum": [
                  "explicit",
                  "inferred"
                ]
              },
              "supporting_fact_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^fact_[0-9]{6,}$"
                }
              },
              "supporting_event_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^evt_[0-9]{6,}$"
                }
              },
              "supporting_relationship_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^rel_[0-9]{6,}$"
                }
              },
              "supporting_conflict_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^conf_[0-9]{6,}$"
                }
              }
            }
          }
        }
      }
