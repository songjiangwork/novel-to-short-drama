{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel-to-short-drama.local/schemas/canonical-relationship-set.schema.json",
  "title": "v1.2 A5 CanonicalRelationshipSet (A5A persisted, v1)",
  "description": "A5 canonical relationship set: canonical relationships (stable rel_* ids) with a relationship state history. A same relationship may carry multiple states over narrative order; successive incompatible states surface as a relationship_state_conflict (A5F).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "relationships"],
  "properties": {
    "schema_version": { "const": 1 },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/canonical_relationship" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bound_entity_ref": {
      "type": "string",
      "pattern": "^(?:char|loc|unres)_[0-9]{4,}$"
    },
    "relationship_id": {
      "type": "string",
      "pattern": "^rel_[0-9]{6,}$"
    },
    "relationship_candidate_ref": {
      "type": "string",
      "pattern": "^CH[0-9]{3,}_C[0-9]{3,}:cand_rel_[0-9]{3,}$"
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paragraph_id", "role", "strength", "excerpt"],
      "properties": {
        "paragraph_id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["primary", "supporting"] },
        "strength": { "enum": ["explicit", "implied", "uncertain"] },
        "excerpt": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "relationship_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_zh",
        "candidate_relationship_refs",
        "evidence_refs",
        "narrative_order"
      ],
      "properties": {
        "state_zh": { "type": "string", "minLength": 1 },
        "candidate_relationship_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relationship_candidate_ref" }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence_ref" }
        },
        "narrative_order": { "type": "integer", "minimum": 1 }
      }
    },
    "canonical_relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationship_id",
        "source_entity_ref",
        "target_entity_ref",
        "direction",
        "relationship_type_zh",
        "candidate_relationship_refs",
        "state_history",
        "first_source_order"
      ],
      "properties": {
        "relationship_id": { "$ref": "#/$defs/relationship_id" },
        "source_entity_ref": { "$ref": "#/$defs/bound_entity_ref" },
        "target_entity_ref": { "$ref": "#/$defs/bound_entity_ref" },
        "direction": { "enum": ["directed", "symmetric", "unknown"] },
        "relationship_type_zh": { "type": "string", "minLength": 1 },
        "candidate_relationship_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relationship_candidate_ref" }
        },
        "state_history": {
          "type": "array",
          "items": { "$ref": "#/$defs/relationship_state" }
        },
        "first_source_order": { "type": "string", "minLength": 1 }
      }
    }
  }
}
