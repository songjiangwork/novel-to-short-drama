{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel-to-short-drama.local/schemas/consolidation-candidate-index.schema.json",
  "title": "v1.2 A5 ConsolidationCandidateIndex (A5A persisted, v1)",
  "description": "A5 indexed consolidation candidate universe. Each candidate carries its A5 global candidate ref (<chunk_id>:<cand_fact_*|cand_evt_*|cand_rel_*>), its A4-bound canonical entity refs (char_* / loc_* / unres_*), and its exact evidence + candidate-extraction provenance. A5A validates shape and category/namespace consistency only; reference existence/provenance is a later A5 slice.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "facts", "events", "relationships"],
  "properties": {
    "schema_version": { "const": 1 },
    "facts": {
      "type": "array",
      "items": { "$ref": "#/$defs/fact_candidate" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event_candidate" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "#/$defs/relationship_candidate" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "artifact_id",
        "revision",
        "content_hash"
      ],
      "properties": {
        "artifact_type": { "type": "string", "minLength": 1 },
        "artifact_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "content_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paragraph_id", "role", "strength", "excerpt"],
      "properties": {
        "paragraph_id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["primary", "supporting"] },
        "strength": { "enum": ["explicit", "implied", "uncertain"] },
        "excerpt": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "bound_entity_ref": {
      "type": "string",
      "pattern": "^(?:char|loc|unres)_[0-9]{4,}$"
    },
    "evidence_strength": {
      "enum": ["explicit", "implied", "uncertain"]
    },
    "fact_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global_candidate_ref",
        "chunk_id",
        "local_candidate_id",
        "source_order_key",
        "fact_type",
        "statement_zh",
        "subject_refs",
        "object_refs",
        "evidence_strength",
        "evidence_refs",
        "candidate_extraction_ref"
      ],
      "properties": {
        "global_candidate_ref": {
          "type": "string",
          "pattern": "^CH[0-9]{3,}_C[0-9]{3,}:cand_fact_[0-9]{3,}$"
        },
        "chunk_id": { "type": "string", "pattern": "^CH[0-9]{3,}_C[0-9]{3,}$" },
        "local_candidate_id": {
          "type": "string",
          "pattern": "^cand_fact_[0-9]{3,}$"
        },
        "source_order_key": { "type": "string", "minLength": 1 },
        "fact_type": {
          "enum": [
            "appearance",
            "continuity_relevant",
            "identity",
            "knowledge",
            "location_state",
            "other",
            "possession",
            "relationship_state",
            "world_fact"
          ]
        },
        "statement_zh": { "type": "string", "minLength": 1 },
        "subject_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/bound_entity_ref" }
        },
        "object_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/bound_entity_ref" }
        },
        "evidence_strength": { "$ref": "#/$defs/evidence_strength" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence_ref" }
        },
        "candidate_extraction_ref": { "$ref": "#/$defs/artifact_ref" }
      }
    },
    "event_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global_candidate_ref",
        "chunk_id",
        "local_candidate_id",
        "source_order_key",
        "summary_zh",
        "participants",
        "locations",
        "temporal_mode",
        "evidence_strength",
        "evidence_refs",
        "candidate_extraction_ref"
      ],
      "properties": {
        "global_candidate_ref": {
          "type": "string",
          "pattern": "^CH[0-9]{3,}_C[0-9]{3,}:cand_evt_[0-9]{3,}$"
        },
        "chunk_id": { "type": "string", "pattern": "^CH[0-9]{3,}_C[0-9]{3,}$" },
        "local_candidate_id": {
          "type": "string",
          "pattern": "^cand_evt_[0-9]{3,}$"
        },
        "source_order_key": { "type": "string", "minLength": 1 },
        "summary_zh": { "type": "string", "minLength": 1 },
        "participants": {
          "type": "array",
          "items": { "$ref": "#/$defs/bound_entity_ref" }
        },
        "locations": {
          "type": "array",
          "items": { "$ref": "#/$defs/bound_entity_ref" }
        },
        "temporal_mode": {
          "enum": ["dream", "flashback", "flashforward", "memory", "normal", "unknown"]
        },
        "evidence_strength": { "$ref": "#/$defs/evidence_strength" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence_ref" }
        },
        "candidate_extraction_ref": { "$ref": "#/$defs/artifact_ref" }
      }
    },
    "relationship_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "global_candidate_ref",
        "chunk_id",
        "local_candidate_id",
        "source_order_key",
        "source_entity_ref",
        "target_entity_ref",
        "relationship_type_zh",
        "state_zh",
        "direction",
        "evidence_strength",
        "evidence_refs",
        "candidate_extraction_ref"
      ],
      "properties": {
        "global_candidate_ref": {
          "type": "string",
          "pattern": "^CH[0-9]{3,}_C[0-9]{3,}:cand_rel_[0-9]{3,}$"
        },
        "chunk_id": { "type": "string", "pattern": "^CH[0-9]{3,}_C[0-9]{3,}$" },
        "local_candidate_id": {
          "type": "string",
          "pattern": "^cand_rel_[0-9]{3,}$"
        },
        "source_order_key": { "type": "string", "minLength": 1 },
        "source_entity_ref": { "$ref": "#/$defs/bound_entity_ref" },
        "target_entity_ref": { "$ref": "#/$defs/bound_entity_ref" },
        "relationship_type_zh": { "type": "string", "minLength": 1 },
        "state_zh": { "type": ["string", "null"], "minLength": 1 },
        "direction": { "enum": ["directed", "symmetric", "unknown"] },
        "evidence_strength": { "$ref": "#/$defs/evidence_strength" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence_ref" }
        },
        "candidate_extraction_ref": { "$ref": "#/$defs/artifact_ref" }
      }
    }
  }
}
