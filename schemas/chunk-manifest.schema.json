{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v1.2 A2 ChunkManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "document_id",
    "source_document_ref",
    "planner_version",
    "profile",
    "chunk_refs",
    "chunk_count",
    "coverage",
    "state"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "document_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "source_document_ref": {"$ref": "#/$defs/sourceDocumentRef"},
    "planner_version": {"const": "a2_chunk_planner_v1"},
    "profile": {"$ref": "#/$defs/profile"},
    "chunk_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourceChunkRef"}
    },
    "chunk_count": {"type": "integer", "minimum": 1},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paragraphs_total", "owned_once", "unowned", "multiply_owned"],
      "properties": {
        "paragraphs_total": {"type": "integer", "minimum": 1},
        "owned_once": {"type": "integer", "minimum": 1},
        "unowned": {"const": 0},
        "multiply_owned": {"const": 0}
      }
    },
    "state": {"const": "CHUNKING_COMPLETE"}
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "artifact_id", "revision", "content_hash"],
      "properties": {
        "artifact_type": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "sourceDocumentRef": {
      "allOf": [
        {"$ref": "#/$defs/artifactRef"},
        {"properties": {"artifact_type": {"const": "source_document"}}}
      ]
    },
    "sourceChunkRef": {
      "allOf": [
        {"$ref": "#/$defs/artifactRef"},
        {"properties": {"artifact_type": {"const": "source_chunk"}}}
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "profile_id",
        "token_counter",
        "ownership_token_budget",
        "context_overlap_token_budget",
        "context_token_budget"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "token_counter": {"const": "utf8-bytes-div3-v1"},
        "ownership_token_budget": {"type": "integer", "minimum": 1},
        "context_overlap_token_budget": {"type": "integer", "minimum": 0},
        "context_token_budget": {"type": "integer", "minimum": 1}
      }
    }
  }
}
