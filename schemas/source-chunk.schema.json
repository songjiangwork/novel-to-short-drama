{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v1.2 A2 SourceChunk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "chunk_id",
    "project_id",
    "document_id",
    "chapter_id",
    "source_document_ref",
    "context_span",
    "ownership_span",
    "paragraph_ids",
    "token_count_method",
    "context_token_count",
    "ownership_token_count"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "chunk_id": {"type": "string", "pattern": "^CH[0-9]{3,}_C[0-9]{3,}$"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "document_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "chapter_id": {"type": "string", "pattern": "^CH[0-9]{3,}$"},
    "source_document_ref": {"$ref": "#/$defs/sourceDocumentRef"},
    "context_span": {"$ref": "#/$defs/paragraphSpan"},
    "ownership_span": {"$ref": "#/$defs/paragraphSpan"},
    "paragraph_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^CH[0-9]{3,}_P[0-9]{4,}$"}
    },
    "token_count_method": {"const": "utf8-bytes-div3-v1"},
    "context_token_count": {"type": "integer", "minimum": 1},
    "ownership_token_count": {"type": "integer", "minimum": 1}
  },
  "$defs": {
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "artifact_id", "revision", "content_hash"],
      "properties": {
        "artifact_type": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "sourceDocumentRef": {
      "allOf": [
        {"$ref": "#/$defs/artifactRef"},
        {"properties": {"artifact_type": {"const": "source_document"}}}
      ]
    },
    "paragraphSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "pattern": "^CH[0-9]{3,}_P[0-9]{4,}$"},
        "end": {"type": "string", "pattern": "^CH[0-9]{3,}_P[0-9]{4,}$"}
      }
    }
  }
}
