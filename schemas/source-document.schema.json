{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v1.2 A1 SourceDocument",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "document_id", "source", "normalization", "structure"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "document_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path", "raw_sha256", "byte_size", "declared_language", "detected_language", "language_detector"],
      "properties": {
        "type": {"enum": ["txt", "pdf"]},
        "path": {"type": "string", "minLength": 1},
        "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_size": {"type": "integer", "minimum": 0},
        "declared_language": {"type": "string", "minLength": 2},
        "detected_language": {"type": "string", "minLength": 1},
        "language_detector": {"type": "string", "minLength": 1}
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_encoding", "newline", "parser_id", "parser_version"],
      "properties": {
        "input_encoding": {"type": "string", "minLength": 1},
        "newline": {"const": "LF"},
        "parser_id": {"const": "short_drama_source_ingestion_v1"},
        "parser_version": {"type": "string", "minLength": 1}
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chapters"],
      "properties": {
        "chapters": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["chapter_id", "title_original", "heading_kind", "paragraphs"],
            "properties": {
              "chapter_id": {"type": "string", "pattern": "^CH[0-9]{3,}$"},
              "title_original": {"type": ["string", "null"], "minLength": 1},
              "heading_kind": {"enum": ["chapter", "part", "prologue", "epilogue", "synthetic"]},
              "paragraphs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["paragraph_id", "text_original", "source_pages"],
                  "properties": {
                    "paragraph_id": {"type": "string", "pattern": "^CH[0-9]{3,}_P[0-9]{4,}$"},
                    "text_original": {"type": "string", "minLength": 1},
                    "source_pages": {
                      "oneOf": [
                        {"type": "null"},
                        {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
