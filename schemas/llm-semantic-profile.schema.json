{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "v1.2 A-I3 Semantic LLM Profile",
  "description": "Result-affecting LLM generation semantics. Deliberately carries no endpoint, timeout, credential, or hostname, so it is a stable semantic identity independent of runtime transport.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "provider_family",
    "model",
    "temperature",
    "max_output_tokens",
    "structured_output_mode",
    "reasoning"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "provider_family": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
    "max_output_tokens": { "type": "integer", "minimum": 1 },
    "structured_output_mode": { "enum": ["none", "json_object", "json_schema"] },
    "reasoning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "effort"],
      "properties": {
        "enabled": { "type": "boolean" },
        "effort": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ]
        }
      }
    }
  }
}
