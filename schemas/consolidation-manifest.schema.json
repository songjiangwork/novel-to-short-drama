{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel-to-short-drama.local/schemas/consolidation-manifest.schema.json",
  "title": "v1.2 A5 ConsolidationManifest (A5A persisted, v1)",
  "description": "A5 root aggregate: the single entrypoint for fact / event / relationship consolidation results. Pins the exact input entity_map_ref (A4 EntityMap), the six A5 artifact refs, the backend-neutral A5 semantic identity, the transitively-exact upstream A3 identity, and the coverage summary. A5A owns the shape only; A5F/A5G persist, bind, and write CURRENT.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "document_id",
    "entity_map_ref",
    "consolidation_candidate_index_ref",
    "consolidation_decision_set_ref",
    "canonical_fact_set_ref",
    "canonical_event_set_ref",
    "canonical_relationship_set_ref",
    "story_conflict_set_ref",
    "semantic_identity",
    "upstream_identity",
    "coverage_summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "document_id": { "type": "string", "minLength": 1 },
    "entity_map_ref": { "$ref": "#/$defs/artifact_ref" },
    "consolidation_candidate_index_ref": { "$ref": "#/$defs/artifact_ref" },
    "consolidation_decision_set_ref": { "$ref": "#/$defs/artifact_ref" },
    "canonical_fact_set_ref": { "$ref": "#/$defs/artifact_ref" },
    "canonical_event_set_ref": { "$ref": "#/$defs/artifact_ref" },
    "canonical_relationship_set_ref": { "$ref": "#/$defs/artifact_ref" },
    "story_conflict_set_ref": { "$ref": "#/$defs/artifact_ref" },
    "semantic_identity": { "$ref": "#/$defs/semantic_identity" },
    "upstream_identity": { "$ref": "#/$defs/upstream_identity" },
    "coverage_summary": { "$ref": "#/$defs/coverage_summary" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "artifact_id",
        "revision",
        "content_hash"
      ],
      "properties": {
        "artifact_type": { "type": "string", "minLength": 1 },
        "artifact_id": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "content_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "a3_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_document_ref",
        "chunk_manifest_ref",
        "candidate_extraction_refs",
        "extraction_profile_id",
        "extraction_profile_hash"
      ],
      "properties": {
        "source_document_ref": { "$ref": "#/$defs/artifact_ref" },
        "chunk_manifest_ref": { "$ref": "#/$defs/artifact_ref" },
        "candidate_extraction_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact_ref" }
        },
        "extraction_profile_id": { "type": "string", "minLength": 1 },
        "extraction_profile_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "upstream_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a3_input"],
      "properties": {
        "a3_input": { "$ref": "#/$defs/a3_input" }
      }
    },
    "prompt_asset_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_id", "prompt_version", "prompt_content_hash"],
      "properties": {
        "prompt_id": { "type": "string", "minLength": 1 },
        "prompt_version": { "type": "integer", "minimum": 1 },
        "prompt_content_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "output_schema_asset_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "schema_hash"],
      "properties": {
        "schema_id": { "type": "string", "minLength": 1 },
        "schema_version": { "type": "integer", "minimum": 1 },
        "schema_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "semantic_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consolidation_profile_id",
        "consolidation_profile_hash",
        "fact_semantic_profile_id",
        "fact_semantic_profile_hash",
        "event_semantic_profile_id",
        "event_semantic_profile_hash",
        "relationship_semantic_profile_id",
        "relationship_semantic_profile_hash",
        "prompt_identities",
        "output_schema_identities",
        "plan_hash",
        "semantic_request_hashes"
      ],
      "properties": {
        "consolidation_profile_id": { "type": "string", "minLength": 1 },
        "consolidation_profile_hash": { "$ref": "#/$defs/sha256" },
        "fact_semantic_profile_id": { "type": "string", "minLength": 1 },
        "fact_semantic_profile_hash": { "$ref": "#/$defs/sha256" },
        "event_semantic_profile_id": { "type": "string", "minLength": 1 },
        "event_semantic_profile_hash": { "$ref": "#/$defs/sha256" },
        "relationship_semantic_profile_id": { "type": "string", "minLength": 1 },
        "relationship_semantic_profile_hash": { "$ref": "#/$defs/sha256" },
        "prompt_identities": {
          "type": "array",
          "items": { "$ref": "#/$defs/prompt_asset_identity" }
        },
        "output_schema_identities": {
          "type": "array",
          "items": { "$ref": "#/$defs/output_schema_asset_identity" }
        },
        "plan_hash": { "$ref": "#/$defs/sha256" },
        "semantic_request_hashes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "coverage_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_candidate_count",
        "event_candidate_count",
        "relationship_candidate_count",
        "canonical_fact_count",
        "canonical_event_count",
        "canonical_relationship_count",
        "uncertain_decision_count",
        "story_conflict_count"
      ],
      "properties": {
        "fact_candidate_count": { "type": "integer", "minimum": 0 },
        "event_candidate_count": { "type": "integer", "minimum": 0 },
        "relationship_candidate_count": { "type": "integer", "minimum": 0 },
        "canonical_fact_count": { "type": "integer", "minimum": 0 },
        "canonical_event_count": { "type": "integer", "minimum": 0 },
        "canonical_relationship_count": { "type": "integer", "minimum": 0 },
        "uncertain_decision_count": { "type": "integer", "minimum": 0 },
        "story_conflict_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
