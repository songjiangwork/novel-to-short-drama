    "main_character_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^char_[0-9]{4,}$"
      }
    },
    "major_arc_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^arc_[0-9]{6,}$"
      }
    },
    "major_turning_point_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^turn_[0-9]{6,}$"
      }
    },
    "major_reveal_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^reveal_[0-9]{6,}$"
      }
    }
  }
}
