{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novel-to-short-drama.local/schemas/b14-adapted-story-skeleton-proposal-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["chronology", "primary_presentation", "outcomes", "dependencies", "world_truth_states", "character_knowledge_states", "character_knowledge_transitions", "audience_knowledge_states", "reveal_transitions", "withholding_boundaries", "setup_payoffs", "arc_checkpoints", "gaps", "beat_accounting", "local_invented_beats"],
  "properties": {
    "chronology": {"type": "array", "items": {"$ref": "#/$defs/chronologyPrecedence"}},
    "primary_presentation": {"type": "array", "items": {"anyOf": [{"$ref": "#/$defs/key"}, {"$ref": "#/$defs/presentationEntry"}]}},
    "outcomes": {"type": "array", "items": {"$ref": "#/$defs/narrativeOutcome"}},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/narrativeDependency"}},
    "world_truth_states": {"type": "array", "items": {"$ref": "#/$defs/worldTruthState"}},
    "character_knowledge_states": {"type": "array", "items": {"$ref": "#/$defs/characterKnowledgeState"}},
    "character_knowledge_transitions": {"type": "array", "items": {"$ref": "#/$defs/characterKnowledgeTransition"}},
    "audience_knowledge_states": {"type": "array", "items": {"$ref": "#/$defs/audienceKnowledgeState"}},
    "reveal_transitions": {"type": "array", "items": {"$ref": "#/$defs/revealTransition"}},
    "withholding_boundaries": {"type": "array", "items": {"$ref": "#/$defs/withholdingBoundary"}},
    "setup_payoffs": {"type": "array", "items": {"$ref": "#/$defs/setupPayoffLink"}},
    "arc_checkpoints": {"type": "array", "items": {"$ref": "#/$defs/arcCheckpoint"}},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/skeletonGap"}},
    "beat_accounting": {"type": "array", "items": {"$ref": "#/$defs/beatAccounting"}},
    "local_invented_beats": {"type": "array", "items": {"$ref": "#/$defs/adaptedStoryBeat"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "nullableKey": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "sourceRef": {"type": "object", "additionalProperties": false, "required": ["kind", "canonical_id"], "properties": {"kind": {"enum": ["character", "location", "fact", "event", "relationship", "arc", "turning_point", "reveal", "payoff"]}, "canonical_id": {"type": "string", "minLength": 1}}},
    "beatParticipant": {"type": "object", "additionalProperties": false, "required": ["kind", "participant_id"], "properties": {"kind": {"enum": ["adapted_character", "anonymous_role"]}, "participant_id": {"$ref": "#/$defs/key"}}},
    "chronologyPrecedence": {"type": "object", "additionalProperties": false, "required": ["before_beat_id", "after_beat_id"], "properties": {"before_beat_id": {"$ref": "#/$defs/key"}, "after_beat_id": {"$ref": "#/$defs/key"}}},
    "presentationEntry": {"type": "object", "additionalProperties": false, "required": ["presentation_entry_id", "adapted_story_beat_id", "semantics", "description_zh"], "properties": {"presentation_entry_id": {"$ref": "#/$defs/key"}, "adapted_story_beat_id": {"$ref": "#/$defs/key"}, "semantics": {"enum": ["full", "teaser", "partial_reveal", "delayed_reveal", "flashback", "recap"]}, "description_zh": {"$ref": "#/$defs/text"}}},
    "narrativeOutcome": {"type": "object", "additionalProperties": false, "required": ["outcome_id", "produced_by_beat_id", "description_zh"], "properties": {"outcome_id": {"$ref": "#/$defs/key"}, "produced_by_beat_id": {"$ref": "#/$defs/key"}, "description_zh": {"$ref": "#/$defs/text"}}},
    "narrativeDependency": {"type": "object", "additionalProperties": false, "required": ["dependency_id", "prerequisite_outcome_id", "required_by_beat_id", "description_zh"], "properties": {"dependency_id": {"$ref": "#/$defs/key"}, "prerequisite_outcome_id": {"$ref": "#/$defs/key"}, "required_by_beat_id": {"$ref": "#/$defs/key"}, "description_zh": {"$ref": "#/$defs/text"}}},
    "worldTruthState": {"type": "object", "additionalProperties": false, "required": ["state_id", "kind", "subject_key", "assertion_zh", "established_by_beat_id", "provenance_zh"], "properties": {"state_id": {"$ref": "#/$defs/key"}, "kind": {"enum": ["plot_critical_secret", "key_object", "relationship", "identity_status", "life_status", "goal", "commitment"]}, "subject_key": {"$ref": "#/$defs/key"}, "assertion_zh": {"$ref": "#/$defs/text"}, "established_by_beat_id": {"$ref": "#/$defs/nullableKey"}, "provenance_zh": {"$ref": "#/$defs/text"}}},
    "characterKnowledgeState": {"type": "object", "additionalProperties": false, "required": ["state_id", "character_id", "knowledge_key", "status", "established_by_beat_id", "provenance_zh"], "properties": {"state_id": {"$ref": "#/$defs/key"}, "character_id": {"$ref": "#/$defs/key"}, "knowledge_key": {"$ref": "#/$defs/key"}, "status": {"enum": ["unknown", "suspected", "confirmed"]}, "established_by_beat_id": {"$ref": "#/$defs/nullableKey"}, "provenance_zh": {"$ref": "#/$defs/text"}}},
    "characterKnowledgeTransition": {"type": "object", "additionalProperties": false, "required": ["transition_id", "character_id", "knowledge_key", "from_status", "to_status", "triggered_by_beat_id"], "properties": {"transition_id": {"$ref": "#/$defs/key"}, "character_id": {"$ref": "#/$defs/key"}, "knowledge_key": {"$ref": "#/$defs/key"}, "from_status": {"enum": ["unknown", "suspected", "confirmed"]}, "to_status": {"enum": ["unknown", "suspected", "confirmed"]}, "triggered_by_beat_id": {"$ref": "#/$defs/key"}}},
    "audienceKnowledgeState": {"type": "object", "additionalProperties": false, "required": ["state_id", "knowledge_key", "status", "provenance_zh"], "properties": {"state_id": {"$ref": "#/$defs/key"}, "knowledge_key": {"$ref": "#/$defs/key"}, "status": {"enum": ["unknown", "suspected", "confirmed"]}, "provenance_zh": {"$ref": "#/$defs/text"}}},
    "revealTransition": {"type": "object", "additionalProperties": false, "required": ["reveal_id", "knowledge_key", "from_status", "to_status", "triggered_by_presentation_id"], "properties": {"reveal_id": {"$ref": "#/$defs/key"}, "knowledge_key": {"$ref": "#/$defs/key"}, "from_status": {"enum": ["unknown", "suspected", "confirmed"]}, "to_status": {"enum": ["unknown", "suspected", "confirmed"]}, "triggered_by_presentation_id": {"$ref": "#/$defs/key"}}},
    "withholdingBoundary": {"type": "object", "additionalProperties": false, "required": ["boundary_id", "knowledge_key", "subject_kind", "subject_id", "must_not_be_confirmed_before_presentation_id", "rationale_zh"], "properties": {"boundary_id": {"$ref": "#/$defs/key"}, "knowledge_key": {"$ref": "#/$defs/key"}, "subject_kind": {"enum": ["audience", "character"]}, "subject_id": {"$ref": "#/$defs/nullableKey"}, "must_not_be_confirmed_before_presentation_id": {"$ref": "#/$defs/key"}, "rationale_zh": {"$ref": "#/$defs/text"}}},
    "setupPayoffLink": {"type": "object", "additionalProperties": false, "required": ["link_id", "setup_beat_id", "payoff_beat_id", "source_provenance_refs", "provenance_zh"], "properties": {"link_id": {"$ref": "#/$defs/key"}, "setup_beat_id": {"$ref": "#/$defs/key"}, "payoff_beat_id": {"$ref": "#/$defs/key"}, "source_provenance_refs": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}}, "provenance_zh": {"$ref": "#/$defs/text"}}},
    "arcCheckpoint": {"type": "object", "additionalProperties": false, "required": ["checkpoint_id", "kind", "subject_id", "dimension", "state_zh", "trigger_beat_id", "provenance_zh"], "properties": {"checkpoint_id": {"$ref": "#/$defs/key"}, "kind": {"enum": ["character", "relationship"]}, "subject_id": {"$ref": "#/$defs/key"}, "dimension": {"enum": ["goal", "belief", "trust", "commitment", "relationship_stance", "self_understanding"]}, "state_zh": {"$ref": "#/$defs/text"}, "trigger_beat_id": {"$ref": "#/$defs/key"}, "provenance_zh": {"$ref": "#/$defs/text"}}},
    "gapAnchor": {"type": "object", "additionalProperties": false, "required": ["kind", "reference_id"], "properties": {"kind": {"enum": ["beat", "dependency", "presentation", "knowledge"]}, "reference_id": {"$ref": "#/$defs/key"}}},
    "skeletonGap": {"type": "object", "additionalProperties": false, "required": ["gap_id", "kind", "disposition", "description_zh", "provenance_zh", "anchors"], "properties": {"gap_id": {"$ref": "#/$defs/key"}, "kind": {"enum": ["causal", "knowledge", "motivation", "relationship", "setup_payoff", "identity_role", "continuity_state", "timeline"]}, "disposition": {"enum": ["accidental", "intentional_ambiguity", "intentional_withholding"]}, "description_zh": {"$ref": "#/$defs/text"}, "provenance_zh": {"$ref": "#/$defs/text"}, "anchors": {"type": "array", "items": {"$ref": "#/$defs/gapAnchor"}}}},
    "beatAccounting": {"type": "object", "additionalProperties": false, "required": ["adapted_story_beat_id", "treatment", "rationale_zh"], "properties": {"adapted_story_beat_id": {"$ref": "#/$defs/key"}, "treatment": {"enum": ["directly_presented", "indirectly_revealed", "background_only"]}, "rationale_zh": {"$ref": "#/$defs/text"}}},
    "adaptedStoryBeat": {"type": "object", "additionalProperties": false, "required": ["adapted_story_beat_id", "identity_key", "summary_zh", "origin", "canon_compatibility", "source_event_refs", "participants", "canonical_anchor_refs", "invention_purpose", "invention_rationale_zh", "invention_provenance_zh"], "properties": {"adapted_story_beat_id": {"$ref": "#/$defs/key"}, "identity_key": {"$ref": "#/$defs/key"}, "summary_zh": {"$ref": "#/$defs/text"}, "origin": {"const": "adaptation_invented"}, "canon_compatibility": {"enum": ["compatible", "deliberate_divergence", "uncertain"]}, "source_event_refs": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}}, "participants": {"type": "array", "items": {"$ref": "#/$defs/beatParticipant"}}, "canonical_anchor_refs": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}}, "invention_purpose": {"enum": ["bridge", "externalization", "continuity_repair", "setup", "payoff", "episode_hook", "dramatic_escalation", "deliberate_divergence", "other"]}, "invention_rationale_zh": {"$ref": "#/$defs/text"}, "invention_provenance_zh": {"$ref": "#/$defs/text"}}}
  }
}
