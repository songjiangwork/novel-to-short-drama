{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Location Registry Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "location_id",
    "display_name",
    "coverage_views"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "location_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "coverage_views": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset"
        ],
        "properties": {
          "asset": {
            "type": "string"
          }
        }
      }
    }
  }
}
